# strchive-link configuration (copy to .env). All vars use the STRCHIVE_LINK_ prefix.
# Nested config uses a double underscore, e.g. STRCHIVE_LINK_DATA__LOCAL_PATH.

# --- Server ---
# STRCHIVE_LINK_HOST=127.0.0.1
# STRCHIVE_LINK_PORT=8000
# STRCHIVE_LINK_TRANSPORT=unified           # unified | http | stdio
# JSON lists. Add the exact public reverse-proxy hostname in production.
# STRCHIVE_LINK_ALLOWED_HOSTS=["localhost","127.0.0.1","::1"]
# STRCHIVE_LINK_ALLOWED_ORIGINS=[]
# Browser deployments must also set STRCHIVE_LINK_CORS_ORIGINS to the same origins;
# CORS response headers and request Origin validation are separate boundaries.
# STRCHIVE_LINK_LOG_LEVEL=INFO
# STRCHIVE_LINK_LOG_FORMAT=console          # console | json

# --- Pinned STRchive snapshot (digest-verified) ---
# Serve a local copy instead of downloading from the pinned GitHub commit:
# STRCHIVE_LINK_DATA__LOCAL_PATH=./tests/fixtures/STRchive-loci.json
# STRCHIVE_LINK_DATA__DOWNLOAD_TIMEOUT=60
